QMainWindow {
    background-color: #1a252f;
}
QWidget {
    background-color: #1a252f;
    color: #ecf0f1;
}
QPushButton {
    background-color: #3498db;
    border: none;
    padding: 8px 15px;
    border-radius: 5px;
}
QPushButton:hover {
    background-color: #2980b9;
}
QPushButton:disabled {
    background-color: #7f8c8d;
}
QGroupBox {
    border: 1px solid #34495e;
    border-radius: 5px;
    margin-top: 8px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}
QTextEdit {
    background-color: #2c3e50;
    border: 1px solid #34495e;
    border-radius: 3px;
}
QTableWidget {
    background-color: #2c3e50;
    alternate-background-color: #34495e;
}
QTableWidget::item {
    color: #ecf0f1;
}
QHeaderView::section {
    background-color: #3498db;
    color: white;
    padding: 4px;
}
QTabWidget::pane {
    border: 1px solid #34495e;
    background-color: #2c3e50;
}
QTabBar::tab {
    background-color: #34495e;
    padding: 6px 15px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #3498db;
}
QProgressBar {
    border: 1px solid #34495e;
    border-radius: 3px;
}
QProgressBar::chunk {
    background-color: #27ae60;
    border-radius: 3px;
}